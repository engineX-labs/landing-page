# Dominio público del sitio, con https y sin barra final. Se usa en el build.
# También se puede fijar en site.config.mjs (esta variable tiene prioridad).
SITE_URL=

# Número de WhatsApp de engineX en formato internacional, sin "+" ni espacios.
# Se usa en el build (links de la página) y en runtime (respuesta de /api/contact).
WHATSAPP_NUMBER=5493548545460

# Carpeta donde se guardan los mensajes del formulario (relativa a donde corre el servidor).
CONTACTS_DIR=data/contacts
