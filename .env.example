# Dominio público del sitio, con https y sin barra final. Se usa en el build.
# También se puede fijar en site.config.mjs (esta variable tiene prioridad).
SITE_URL=

# Número de WhatsApp de engineX en formato internacional, sin "+" ni espacios.
# Se usa en el build (links de WhatsApp de la página y de Fidel).
WHATSAPP_NUMBER=5493548545450

# Carpeta donde se guardan los emails de la lista de espera (sin Redis; necesita disco persistente).
WAITLIST_DIR=data/waitlist

# Upstash Redis (en Vercel los carga solos la integración de Storage → Upstash for Redis).
# Con estas variables los emails (lista `waitlist`) se guardan en Redis (y en Vercel hay límite de 5 envíos por IP cada 10 minutos).
# Sin ellas se guardan en WAITLIST_DIR (en Vercel no: ahí la lista de espera avisa que no pudo guardar).
# También se aceptan UPSTASH_REDIS_REST_URL y UPSTASH_REDIS_REST_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativa si no usás la integración de Vercel (se aceptan en lugar de las KV_*):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Fidel, el asistente de IA (Gemini). Solo servidor: nunca va al navegador ni lleva prefijo PUBLIC_.
# Sin GEMINI_API_KEY el widget no aparece. En Vercel además hace falta Redis (los límites viven ahí).
GEMINI_API_KEY=
# Modelo de Gemini (opcional; por defecto gemini-2.5-flash-lite).
GEMINI_MODEL=
# Mensajes por día en total, entre todas las visitas (opcional; por defecto 300).
ASSISTANT_DAILY_LIMIT=

# Ajustes finos de Fidel (todos opcionales; un valor inválido o fuera de rango se ignora y se usa el de la derecha).
# URL base de la API de Gemini: solo https (http únicamente hacia localhost). Por defecto https://generativelanguage.googleapis.com/v1beta
GEMINI_API_BASE=
# Espera máxima de la respuesta, en milisegundos (1000 a 60000). Por defecto 15000.
GEMINI_TIMEOUT_MS=
# Creatividad de las respuestas (0 a 2). Por defecto 0.4.
GEMINI_TEMPERATURE=
# Tope de tokens de cada respuesta (50 a 2000). Por defecto 400.
ASSISTANT_MAX_OUTPUT_TOKENS=
# Límite por IP (solo en Vercel con Redis): mensajes por ventana. Por defecto 12 cada 10 m.
ASSISTANT_RATE_LIMIT_MESSAGES=
# Ventana del límite por IP: número y unidad (ms, s, m, h, d), por ejemplo "10 m".
ASSISTANT_RATE_LIMIT_WINDOW=
