---
import { nav, whatsappLines } from "../lib/site";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="container-x flex flex-col gap-8 py-12 md:flex-row md:items-start md:justify-between">
    <div class="flex flex-col gap-4">
      <Logo height={24} title="engineX" />
      <p class="small m-0 max-w-[36ch] text-ink-muted">
        Diseñamos y desarrollamos software a medida para negocios que quieren crecer.
      </p>
    </div>
    <nav aria-label="Pie de página">
      <ul class="m-0 flex list-none flex-col gap-1 p-0 sm:flex-row sm:gap-6">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="footer-link small"
                data-opens-demo={"demo" in item ? "" : undefined}
                aria-haspopup={"demo" in item ? "dialog" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/social-engine" class="footer-link small">Social Engine</a>
        </li>
      </ul>
    </nav>
    <div class="flex flex-col gap-1">
      {
        whatsappLines.map((line) => (
          <a href={line.url} class="footer-link small" target="_blank" rel="noopener">
            WhatsApp {line.display}
          </a>
        ))
      }
      <p class="small m-0 text-ink-muted">© {year} engineX</p>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-link:hover {
      color: var(--ink);
    }
  }
</style>
