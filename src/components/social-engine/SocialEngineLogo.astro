---
// Logo provisorio: el isotipo de engineX más "Social Engine". El definitivo lo diseña el equipo.
// En el tema claro la flecha y la palabra "Social" llevan el degradé de los verbos del título.
import Logo from "../Logo.astro";

interface Props {
  height?: number;
}

const { height = 28 } = Astro.props;
---

<span class="se-logo">
  <Logo variant="mark" height={height} decorative gradientId={`se-logo-gradient-${height}`} />
  <span class="se-logo-word"><span class="se-logo-social">Social</span> Engine</span>
</span>

<style>
  .se-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .se-logo-word {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    white-space: nowrap;
  }
  /* Mismo degradé de texto que los verbos (paradas oscuras, ≥ 4,5:1 sobre Papel). */
  :global(html[data-theme="light"]) .se-logo-social {
    background: var(--se-gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
