---
import MockWindow from "./MockWindow.astro";
---

<MockWindow title="Nuevo posteo">
  <div class="mk-card mk-stack">
    <span class="mk-muted">Texto</span>
    <span>Arrancó el otoño y la carta cambió. Probá la nueva receta de esta semana.</span>
    <span class="mk-muted mk-right">79 / 2.200</span>
  </div>
  <div class="mk-row">
    <span class="mk-pill mk-pill-on">Instagram</span>
    <span class="mk-pill mk-pill-on">Facebook</span>
    <span class="mk-pill">TikTok</span>
    <span class="mk-pill">LinkedIn</span>
  </div>
  <div class="mk-card mk-row mk-between">
    <span>Programado para <b>jueves 6, 18:30</b></span>
    <span class="mk-ok">Dentro de los límites</span>
  </div>
  <div class="mk-row">
    <span class="mk-btn mk-btn-on">Programar</span>
    <span class="mk-btn">Duplicar en otra red</span>
  </div>
</MockWindow>
