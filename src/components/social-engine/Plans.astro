---
import Check from "@lucide/astro/icons/check";
import CircleCheck from "@lucide/astro/icons/circle-check";
import { buildWhatsappUrl } from "../../lib/contact";
import { whatsapp } from "../../lib/site";
import { planGuarantees, plans, whatsappGreeting } from "../../lib/social-engine-content";
import Button from "../Button.astro";

const talkUrl = buildWhatsappUrl(whatsapp.number, whatsappGreeting);
---

<section id="planes" class="se-section" aria-labelledby="planes-title">
  <div class="container-x">
    <div class="se-head se-reveal">
      <h2 id="planes-title" class="se-h2">Un plan para cada forma de trabajar</h2>
      <p class="se-lead">Todavía no publicamos precios. Sumate a la lista y los vas a conocer antes del lanzamiento.</p>
      <ul class="se-guarantees m-0 list-none p-0">
        {
          planGuarantees.map((text) => (
            <li>
              <CircleCheck size={18} aria-hidden="true" class="text-success" />
              {text}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="se-plans se-stagger">
      {
        plans.map((plan) => (
          <article class:list={["se-card", "se-plan", plan.featured && "se-plan-featured"]}>
            {plan.featured && <span class="ex-tag ex-tag-accent se-plan-badge">Recomendado</span>}
            <h3 class="heading-3 m-0">{plan.name}</h3>
            <p class="small m-0 text-ink-muted">{plan.audience}</p>
            <ul class="se-plan-list m-0 list-none p-0">
              {plan.features.map((feature) => (
                <li>
                  <Check size={18} aria-hidden="true" class="shrink-0 text-success" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            {plan.key === "agency" ? (
              <Button variant="secondary" href={talkUrl} target="_blank" rel="noopener">
                Hablemos por WhatsApp<span class="sr-only"> (se abre en otra pestaña)</span>
              </Button>
            ) : (
              <Button variant={plan.featured ? "primary" : "secondary"} href="#lista">
                Sumarme a la lista
              </Button>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .se-guarantees {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
    font-size: 14px;
  }
  .se-guarantees li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .se-plans {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }
  @media (min-width: 900px) {
    .se-plans {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .se-plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-6);
  }
  .se-plan-list {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-3);
  }
  .se-plan-list li {
    display: flex;
    gap: var(--space-2);
  }
  /* El recomendado: más alto, con borde de degradé y un brillo de color que sube desde abajo. */
  .se-plan-featured {
    padding-block: calc(var(--space-12) + var(--space-2));
    border: 2px solid transparent;
    background:
      linear-gradient(var(--surface-raised), var(--surface-raised)) padding-box,
      var(--se-gradient) border-box;
    box-shadow: 0 30px 70px -24px rgb(255 91 46 / 0.4);
  }
  .se-plan-badge {
    align-self: flex-start;
  }
</style>
