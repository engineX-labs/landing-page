---
// Logo de engineX (concepto 06) dibujado inline para que siga al tema.
import { MARK_ACCENT, MARK_INK, WORD } from "./logo-paths";

interface Props {
  variant?: "full" | "mark";
  tone?: "auto" | "onDark" | "onLight" | "mono";
  height?: number;
  title?: string;
  class?: string;
  decorative?: boolean;
  /**
   * Id del degradé de la flecha (ignite → magenta → violeta). Si se pasa, el degradé se ve solo
   * en el tema claro; en oscuro la flecha sigue siendo ignite. Tiene que ser único en la página.
   */
  gradientId?: string;
}

const {
  variant = "full",
  tone = "auto",
  height = variant === "mark" ? 40 : 32,
  title = "engineX",
  class: className,
  decorative = false,
  gradientId,
} = Astro.props;

// A 24px o menos el trazo de 28 se empasta: el isotipo usa un trazo óptico más grueso.
const small = variant === "mark" && height <= 24;
const viewBox =
  variant === "mark" ? (small ? "700 42 175 175" : "706 48 163 163") : "44 48 826 197";
const ratio = variant === "mark" ? 1 : 826 / 197;
const a11y = decorative
  ? { "aria-hidden": "true" as const }
  : { role: "img" as const, "aria-label": title };
---

<svg
  class:list={["ex-logo", `ex-logo-${tone}`, className]}
  viewBox={viewBox}
  style={gradientId ? `--ex-logo-gradient: url(#${gradientId})` : undefined}
  height={height}
  width={Math.round(height * ratio)}
  {...a11y}
>
  {
    gradientId && (
      <defs>
        <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#ff5b2e" />
          <stop offset="0.55" stop-color="#e0307a" />
          <stop offset="1" stop-color="#7c5cff" />
        </linearGradient>
      </defs>
    )
  }
  {variant === "full" && <path class="ex-logo-ink-f" fill-rule="evenodd" d={WORD} />}
  <g
    fill="none"
    stroke-width={small ? 34 : 28}
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path class="ex-logo-ink-s" d={MARK_INK} />
    <path class:list={["ex-logo-accent-s", gradientId && "ex-logo-accent-gradient"]} d={MARK_ACCENT} />
  </g>
</svg>

<style>
  /* El degradé solo en el tema claro. Sin capa, le gana al `stroke` de `.ex-logo` de global.css. */
  :global(html[data-theme="light"]) .ex-logo-accent-gradient {
    stroke: var(--ex-logo-gradient);
  }
</style>
