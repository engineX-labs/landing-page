<script>
  import {
    formatArs,
    LAST_INVOICE_NUMBER,
    matchesQuery,
    simulateInvoice,
    totalDebt,
  } from "../lib/freggiaro-demo";

  const root = document.querySelector<HTMLElement>("[data-demo]");

  if (root) {
    // Menú: flechas arriba/abajo (o izquierda/derecha), Home y End mueven la selección.
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const title = root.querySelector<HTMLElement>("[data-title]");

    const selectTab = (index: number, { focus = false } = {}) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (title) title.textContent = tabs[index].dataset.label ?? "";
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => selectTab(i));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === "ArrowDown" || event.key === "ArrowRight"
            ? (i + 1) % tabs.length
            : event.key === "ArrowUp" || event.key === "ArrowLeft"
              ? (i + last) % tabs.length
              : event.key === "Home"
                ? 0
                : event.key === "End"
                  ? last
                  : null;
        if (next === null) return;
        event.preventDefault();
        selectTab(next, { focus: true });
      });
    });

    // Dashboard: un período a la vez.
    const periodButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-period]")];
    const periodViews = [...root.querySelectorAll<HTMLElement>("[data-period-view]")];
    for (const button of periodButtons) {
      button.addEventListener("click", () => {
        for (const other of periodButtons) {
          other.setAttribute("aria-pressed", String(other === button));
        }
        for (const view of periodViews) {
          view.hidden = view.dataset.periodView !== button.dataset.period;
        }
      });
    }

    // Gráfico de línea: el punto más cercano al cursor o al dedo.
    interface HoverPoint {
      x: number;
      y: number;
      text: string;
    }
    for (const chart of root.querySelectorAll<HTMLElement>("[data-chart]")) {
      const points: HoverPoint[] = JSON.parse(chart.dataset.points ?? "[]");
      const marker = chart.querySelector<HTMLElement>("[data-marker]");
      const readout = chart.closest("section")?.querySelector<HTMLElement>("[data-readout]");
      const show = (event: PointerEvent) => {
        if (!marker || !readout || points.length === 0) return;
        const box = chart.getBoundingClientRect();
        const at = (event.clientX - box.left) / box.width;
        let best = points[0];
        for (const point of points) {
          if (Math.abs(point.x - at) < Math.abs(best.x - at)) best = point;
        }
        marker.hidden = false;
        marker.style.setProperty("--x", String(best.x));
        marker.style.setProperty("--y", String(best.y));
        readout.textContent = best.text;
      };
      chart.addEventListener("pointermove", show);
      chart.addEventListener("pointerdown", show);
    }

    // Productos: búsqueda y categoría juntas.
    const search = root.querySelector<HTMLInputElement>("[data-search]");
    const categoryButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-category]")];
    const rows = [...root.querySelectorAll<HTMLElement>("[data-product]")];
    const count = root.querySelector<HTMLElement>("[data-products-count]");
    const empty = root.querySelector<HTMLElement>("[data-products-empty]");
    let category = "";

    const applyFilter = () => {
      const query = search?.value ?? "";
      let shown = 0;
      for (const row of rows) {
        const visible =
          (!category || row.dataset.cat === category) &&
          matchesQuery(row.dataset.text ?? "", query);
        row.hidden = !visible;
        if (visible) shown++;
      }
      if (count) count.textContent = `${shown} de ${rows.length} productos`;
      if (empty) empty.hidden = shown > 0;
    };

    search?.addEventListener("input", applyFilter);
    for (const button of categoryButtons) {
      button.addEventListener("click", () => {
        category = button.dataset.category ?? "";
        for (const other of categoryButtons) {
          other.setAttribute("aria-pressed", String(other === button));
        }
        applyFilter();
      });
    }

    // Clientes: búsqueda, filtro de deuda y pagos simulados.
    const clientRows = [...root.querySelectorAll<HTMLElement>("[data-client-row]")];
    const clientSearch = root.querySelector<HTMLInputElement>("[data-client-search]");
    const debtButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-debt-filter]")];
    const clientCount = root.querySelector<HTMLElement>("[data-clients-count]");
    const clientEmpty = root.querySelector<HTMLElement>("[data-clients-empty]");
    const debtTotalEl = root.querySelector<HTMLElement>("[data-debt-total]");
    const debtorsEl = root.querySelector<HTMLElement>("[data-debtors]");
    const payStatus = root.querySelector<HTMLElement>("[data-pay-status]");
    const clientsReset = root.querySelector<HTMLButtonElement>("[data-clients-reset]");
    let onlyDebt = false;

    const balanceOf = (row: HTMLElement) => Number(row.dataset.balance ?? 0);

    const applyClients = () => {
      const query = clientSearch?.value ?? "";
      let shown = 0;
      for (const row of clientRows) {
        const visible =
          (!onlyDebt || balanceOf(row) > 0) && matchesQuery(row.dataset.text ?? "", query);
        row.hidden = !visible;
        if (visible) shown++;
      }
      if (clientCount) clientCount.textContent = `${shown} de ${clientRows.length} clientes`;
      if (clientEmpty) clientEmpty.hidden = shown > 0;
    };

    const setBalance = (row: HTMLElement, balance: number) => {
      row.dataset.balance = String(balance);
      const label = row.querySelector<HTMLElement>("[data-balance-label]");
      if (label) {
        label.textContent = balance > 0 ? formatArs(balance) : "Al día";
        label.classList.toggle("fg-badge-warn", balance > 0);
        label.classList.toggle("fg-badge-ok", balance <= 0);
      }
      const pay = row.querySelector<HTMLButtonElement>("[data-pay]");
      if (pay) pay.hidden = balance <= 0;
    };

    const refreshDebt = () => {
      const { total, debtors } = totalDebt(clientRows.map(balanceOf));
      if (debtTotalEl) debtTotalEl.textContent = formatArs(total);
      if (debtorsEl) debtorsEl.textContent = String(debtors);
    };

    clientSearch?.addEventListener("input", applyClients);
    for (const button of debtButtons) {
      button.addEventListener("click", () => {
        onlyDebt = button.dataset.debtFilter === "debt";
        for (const other of debtButtons) {
          other.setAttribute("aria-pressed", String(other === button));
        }
        applyClients();
      });
    }

    for (const row of clientRows) {
      row.querySelector<HTMLButtonElement>("[data-pay]")?.addEventListener("click", () => {
        const amount = balanceOf(row);
        setBalance(row, 0);
        refreshDebt();
        applyClients();
        if (payStatus) {
          payStatus.textContent = `Registramos un pago de ${formatArs(amount)} de ${row.dataset.name}. Su cuenta corriente quedó al día. Es una simulación.`;
          // El botón desaparece: el foco pasa al aviso para no perderse.
          payStatus.focus();
        }
        if (clientsReset) clientsReset.hidden = false;
      });
    }

    clientsReset?.addEventListener("click", () => {
      for (const row of clientRows) setBalance(row, Number(row.dataset.initial ?? 0));
      refreshDebt();
      applyClients();
      if (payStatus) payStatus.textContent = "";
      clientsReset.hidden = true;
      clientSearch?.focus();
    });

    // Ventas y Facturación: la factura es de mentira y vive solo en la página.
    const status = root.querySelector<HTMLElement>("[data-sales-status]");
    const reset = root.querySelector<HTMLButtonElement>("[data-sales-reset]");
    const gotoFiscal = root.querySelector<HTMLButtonElement>("[data-goto-fiscal]");
    const idleStatus = status?.textContent?.trim() ?? "";
    const invoiceButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-invoice]")];
    const fiscalRows = [...root.querySelectorAll<HTMLTableRowElement>("[data-fiscal-row]")];
    let sequence = LAST_INVOICE_NUMBER;

    const fiscalOf = (button: HTMLButtonElement) =>
      button.closest("td")?.querySelector<HTMLElement>("[data-fiscal]") ?? null;
    const labelOf = (button: HTMLButtonElement) => button.querySelector("span");

    for (const button of invoiceButtons) {
      button.addEventListener("click", () => {
        if (button.getAttribute("aria-disabled") === "true") return;
        const fiscal = fiscalOf(button);
        const row = fiscalRows[Number(button.dataset.index)];
        if (!fiscal || !row) return;

        sequence += 1;
        const invoice = simulateInvoice(sequence);
        fiscal.textContent = invoice.label;
        fiscal.classList.remove("fg-badge-none");
        fiscal.classList.add("fg-badge-afip");
        button.setAttribute("aria-disabled", "true");
        const label = labelOf(button);
        if (label) label.textContent = "Facturada";

        const labelCell = row.querySelector("[data-fiscal-label]");
        const caeCell = row.querySelector("[data-fiscal-cae]");
        if (labelCell) labelCell.textContent = invoice.label;
        if (caeCell) caeCell.textContent = invoice.cae;
        row.hidden = false;

        if (status) {
          status.textContent = `Emitimos la ${invoice.label} para ${button.dataset.client}. CAE de prueba ${invoice.cae}. Es una simulación, sin validez fiscal.`;
        }
        if (gotoFiscal) gotoFiscal.hidden = false;
        if (reset) reset.hidden = false;
      });
    }

    gotoFiscal?.addEventListener("click", () => selectTab(tabs.length - 1, { focus: true }));

    reset?.addEventListener("click", () => {
      sequence = LAST_INVOICE_NUMBER;
      for (const button of invoiceButtons) {
        const fiscal = fiscalOf(button);
        if (fiscal) {
          fiscal.textContent = fiscal.dataset.empty ?? "";
          fiscal.classList.remove("fg-badge-afip");
          fiscal.classList.add("fg-badge-none");
        }
        button.removeAttribute("aria-disabled");
        const label = labelOf(button);
        if (label) label.textContent = "Facturar";
        const row = fiscalRows[Number(button.dataset.index)];
        if (row) row.hidden = true;
      }
      if (status) status.textContent = idleStatus;
      if (gotoFiscal) gotoFiscal.hidden = true;
      reset.hidden = true;
      invoiceButtons[0]?.focus();
    });
  }
</script>
