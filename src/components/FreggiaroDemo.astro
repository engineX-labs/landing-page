---
import { Image } from "astro:assets";
import DollarSign from "@lucide/astro/icons/dollar-sign";
import LayoutDashboard from "@lucide/astro/icons/layout-dashboard";
import Package from "@lucide/astro/icons/package";
import Receipt from "@lucide/astro/icons/receipt";
import ShoppingCart from "@lucide/astro/icons/shopping-cart";
import TrendingUp from "@lucide/astro/icons/trending-up";
import User from "@lucide/astro/icons/user";
import Users from "@lucide/astro/icons/users";
import Wallet from "@lucide/astro/icons/wallet";
import emblem from "../assets/freggiaro/emblem.webp";
import {
  areaOf,
  categories,
  clientSearchText,
  clients,
  donutSegments,
  formatArs,
  formatCuit,
  linePoints,
  pathOf,
  periods,
  products,
  ratios,
  sales,
  searchText,
  stockLevel,
  totalDebt,
} from "../lib/freggiaro-demo";

const tabs = [
  { id: "dashboard", label: "Dashboard", icon: LayoutDashboard },
  { id: "productos", label: "Productos", icon: Package },
  { id: "clientes", label: "Clientes", icon: Users },
  { id: "ventas", label: "Ventas", icon: ShoppingCart },
  { id: "facturacion", label: "Facturación", icon: Receipt },
] as const;

const percent = (n: number) => `${n.toFixed(1).replace(".", ",")} %`;
const number = (n: number) => n.toLocaleString("es-AR");

// Lienzo del gráfico de línea: el SVG se estira al ancho, así que las posiciones se guardan
// como fracciones y el marcador del hover se ubica con porcentajes.
const CHART_W = 600;
const CHART_H = 200;
const SEGMENT_COLORS = ["#fbbf24", "#f59e0b", "#d97706", "#b45309"];

const views = periods.map((p) => {
  const points = linePoints(
    p.series.map((s) => s.value),
    CHART_W,
    CHART_H,
  );
  return {
    ...p,
    line: pathOf(points),
    area: areaOf(points, CHART_H),
    // Lo que lee el script al pasar el cursor: posición relativa y texto ya formateado.
    hover: JSON.stringify(
      points.map((pt, i) => ({
        x: pt.x / CHART_W,
        y: pt.y / CHART_H,
        text: `${p.series[i].label}: ${formatArs(p.series[i].value)}`,
      })),
    ),
    topRatios: ratios(p.top.map((t) => t.amount)),
    segments: donutSegments(p.payments),
  };
});

const debt = totalDebt(clients.map((c) => c.balance));
---

<!-- La ventana replica la interfaz de Freggiaro: sus colores y su tipografía, no los de engineX. -->
    <div class="demo" data-demo>
      <div class="fg-logo">
        <Image src={emblem} alt="Freggiaro" width={48} height={48} loading="lazy" />
      </div>

      <header class="fg-header">
        <div class="fg-title">
          <span class="fg-title-bar" aria-hidden="true"></span>
          <p class="fg-title-text" aria-hidden="true" data-title>Dashboard</p>
        </div>
        <div class="fg-user">
          <span class="fg-user-icon" aria-hidden="true"><User size={16} /></span>
          <span class="fg-user-text">
            <span class="fg-user-name">Administrador</span>
            <span class="fg-user-sub">Datos ficticios</span>
          </span>
        </div>
      </header>

      <div
        class="fg-nav"
        role="tablist"
        aria-orientation="vertical"
        aria-label="Secciones de Freggiaro"
      >
        {
          tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`demo-tab-${tab.id}`}
              class="fg-tab"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`demo-panel-${tab.id}`}
              tabindex={i === 0 ? 0 : -1}
              data-tab
              data-label={tab.label}
            >
              <tab.icon size={22} aria-hidden="true" />
              <span>{tab.label}</span>
            </button>
          ))
        }
      </div>

      <!-- Dashboard -->
      <div
        role="tabpanel"
        id="demo-panel-dashboard"
        class="fg-panel"
        aria-labelledby="demo-tab-dashboard"
        tabindex="0"
        data-panel
      >
        <div class="fg-head">
          <div>
            <h3 class="fg-h">Resumen principal</h3>
            <p class="fg-sub">Las métricas clave de tu negocio, en un vistazo.</p>
          </div>
          <div class="fg-chips" role="group" aria-label="Período">
            {
              periods.map((p) => (
                <button
                  type="button"
                  class="fg-chip"
                  aria-pressed={p.id === "mes" ? "true" : "false"}
                  data-period={p.id}
                >
                  {p.label}
                </button>
              ))
            }
          </div>
        </div>

        {
          views.map((p) => (
            <div class="fg-view" hidden={p.id !== "mes"} data-period-view={p.id}>
              <dl class="fg-stats">
                <div class="fg-card fg-stat">
                  <span class="fg-stat-icon" aria-hidden="true">
                    <DollarSign size={22} />
                  </span>
                  <dt class="fg-muted">Ventas totales</dt>
                  <dd class="fg-stat-value">{formatArs(p.total)}</dd>
                  <dd class="fg-stat-note">
                    <TrendingUp size={16} aria-hidden="true" class="fg-up" />
                    <span class="fg-up">+{percent(p.delta)}</span>
                    <span class="fg-muted">vs. período anterior</span>
                  </dd>
                </div>
                <div class="fg-card fg-stat">
                  <span class="fg-stat-icon" aria-hidden="true">
                    <ShoppingCart size={22} />
                  </span>
                  <dt class="fg-muted">Cant. de ventas</dt>
                  <dd class="fg-stat-value">{number(p.count)}</dd>
                  <dd class="fg-stat-note fg-muted">Ticket prom.: {formatArs(p.total / p.count)}</dd>
                </div>
                <div class="fg-card fg-stat">
                  <span class="fg-stat-icon" aria-hidden="true">
                    <Users size={22} />
                  </span>
                  <dt class="fg-muted">Clientes activos</dt>
                  <dd class="fg-stat-value">{number(p.clients)}</dd>
                  <dd class="fg-stat-note fg-muted">Con compras en el período</dd>
                </div>
                <div class="fg-card fg-stat">
                  <span class="fg-stat-icon" aria-hidden="true">
                    <Package size={22} />
                  </span>
                  <dt class="fg-muted">Ítems vendidos</dt>
                  <dd class="fg-stat-value">{number(p.items)}</dd>
                  <dd class="fg-stat-note fg-muted">Unidades en total</dd>
                </div>
              </dl>

              <section class="fg-card fg-block" aria-label="Evolución de ventas">
                <div class="fg-block-head">
                  <h4 class="fg-h4">Evolución de ventas</h4>
                  <p class="fg-readout" data-readout aria-hidden="true">
                    Pasá el cursor o tocá el gráfico
                  </p>
                </div>
                <div class="fg-chart" data-chart data-points={p.hover}>
                  <svg
                    viewBox={`0 0 ${CHART_W} ${CHART_H}`}
                    preserveAspectRatio="none"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path class="fg-area" d={p.area} />
                    <path class="fg-line" d={p.line} />
                  </svg>
                  <span class="fg-marker" data-marker hidden />
                </div>
                <ol class="fg-xlabels" aria-label={p.seriesLabel}>
                  {
                    p.series.map((s) => (
                      <li>
                        <span class="sr-only">
                          {s.label}: {formatArs(s.value)}
                        </span>
                        <span aria-hidden="true">{s.label}</span>
                      </li>
                    ))
                  }
                </ol>
              </section>

              <div class="fg-pair">
                <section class="fg-card fg-block" aria-label="Métodos de pago">
                  <h4 class="fg-h4">Métodos de pago</h4>
                  <div class="fg-donut-wrap">
                    <div class="fg-donut">
                      <svg viewBox="0 0 42 42" aria-hidden="true" focusable="false">
                        {p.segments.map((seg, i) => (
                          <circle
                            cx="21"
                            cy="21"
                            r="15.9155"
                            fill="none"
                            stroke={SEGMENT_COLORS[i]}
                            stroke-width="5"
                            stroke-dasharray={`${Math.max(seg.pct - 0.8, 0)} ${100 - Math.max(seg.pct - 0.8, 0)}`}
                            stroke-dashoffset={25 + seg.offset}
                          />
                        ))}
                      </svg>
                      <span class="fg-donut-center">
                        <strong>{number(p.count)}</strong>
                        <span class="fg-muted">ventas</span>
                      </span>
                    </div>
                    <ul class="fg-legend">
                      {p.payments.map((m, i) => (
                        <li>
                          <span
                            class="fg-swatch"
                            style={`background:${SEGMENT_COLORS[i]}`}
                            aria-hidden="true"
                          />
                          <span class="fg-legend-label">{m.label}</span>
                          <strong class="fg-up">{m.pct} %</strong>
                        </li>
                      ))}
                    </ul>
                  </div>
                </section>

                <section class="fg-card fg-block" aria-label="Productos que más venden">
                  <h4 class="fg-h4">Top productos</h4>
                  <ol class="fg-top">
                    {p.top.map((t, i) => (
                      <li>
                        <div class="fg-top-row">
                          <span class="fg-top-name">{t.name}</span>
                          <strong class="fg-num fg-up">{formatArs(t.amount)}</strong>
                        </div>
                        <span class="fg-top-track" aria-hidden="true">
                          <span class="fg-top-fill" style={`--r:${p.topRatios[i].toFixed(3)}`} />
                        </span>
                      </li>
                    ))}
                  </ol>
                </section>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Productos -->
      <div
        role="tabpanel"
        id="demo-panel-productos"
        class="fg-panel"
        aria-labelledby="demo-tab-productos"
        tabindex="0"
        hidden
        data-panel
      >
        <div class="fg-head">
          <div>
            <h3 class="fg-h">Gestión de productos</h3>
            <p class="fg-sub">Catálogo, precios y stock de tu negocio.</p>
          </div>
          <p class="fg-muted fg-count" role="status" data-products-count>
            {products.length} de {products.length} productos
          </p>
        </div>

        <div class="fg-field">
          <label class="fg-label" for="demo-search">Buscar</label>
          <input
            id="demo-search"
            class="fg-input"
            type="search"
            placeholder="Buscar por SKU, nombre, marca o categoría…"
            autocomplete="off"
            data-search
          />
        </div>

        <div class="fg-chips" role="group" aria-label="Categoría">
          <button type="button" class="fg-chip" aria-pressed="true" data-category="">
            Todas
          </button>
          {
            categories.map((c) => (
              <button type="button" class="fg-chip" aria-pressed="false" data-category={c}>
                {c}
              </button>
            ))
          }
        </div>

        <div class="fg-card fg-table-wrap">
          <table class="fg-table">
            <caption class="sr-only">Productos del catálogo</caption>
            <thead>
              <tr>
                <th scope="col" class="fg-md">SKU</th>
                <th scope="col">Nombre</th>
                <th scope="col" class="fg-md">Categoría</th>
                <th scope="col">Stock</th>
                <th scope="col" class="fg-right">Precio</th>
              </tr>
            </thead>
            <tbody>
              {
                products.map((p) => {
                  const level = stockLevel(p.stock);
                  return (
                    <tr data-product data-text={searchText(p)} data-cat={p.category}>
                      <td class="fg-md">
                        <span class="fg-sku">{p.sku}</span>
                      </td>
                      <td>
                        <span class="fg-strong">{p.name}</span>
                        <span class="fg-small fg-muted">
                          {p.brand}
                          <span class="fg-mono fg-sm-only"> · {p.sku}</span>
                        </span>
                      </td>
                      <td class="fg-md">
                        <span class="fg-pill">{p.category}</span>
                      </td>
                      <td>
                        <span class:list={["fg-stock", level === "out" && "fg-stock-out"]}>
                          {level === "out" ? "Sin stock" : `${p.stock} un.`}
                        </span>
                        {level === "low" && <span class="sr-only">Stock bajo</span>}
                      </td>
                      <td class="fg-right fg-num fg-price">{formatArs(p.price)}</td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
        <p class="fg-sub" hidden data-products-empty>
          No encontramos productos con esa búsqueda.
        </p>
      </div>

      <!-- Clientes -->
      <div
        role="tabpanel"
        id="demo-panel-clientes"
        class="fg-panel"
        aria-labelledby="demo-tab-clientes"
        tabindex="0"
        hidden
        data-panel
      >
        <div class="fg-head">
          <div>
            <h3 class="fg-h">Cartera de clientes</h3>
            <p class="fg-sub">Contacto, condición frente al IVA y cuenta corriente de cada cliente.</p>
          </div>
          <button type="button" class="fg-chip" hidden data-clients-reset>Reiniciar saldos</button>
        </div>

        <dl class="fg-stats fg-stats-3">
          <div class="fg-card fg-stat">
            <span class="fg-stat-icon" aria-hidden="true"><Users size={22} /></span>
            <dt class="fg-muted">Clientes</dt>
            <dd class="fg-stat-value">{clients.length}</dd>
          </div>
          <div class="fg-card fg-stat">
            <span class="fg-stat-icon" aria-hidden="true"><Wallet size={22} /></span>
            <dt class="fg-muted">A cobrar en cuenta corriente</dt>
            <dd class="fg-stat-value" data-debt-total>{formatArs(debt.total)}</dd>
          </div>
          <div class="fg-card fg-stat">
            <span class="fg-stat-icon" aria-hidden="true"><DollarSign size={22} /></span>
            <dt class="fg-muted">Con saldo pendiente</dt>
            <dd class="fg-stat-value" data-debtors>{debt.debtors}</dd>
          </div>
        </dl>

        <div class="fg-field">
          <label class="fg-label" for="demo-client-search">Buscar cliente</label>
          <input
            id="demo-client-search"
            class="fg-input"
            type="search"
            placeholder="Nombre o CUIT…"
            autocomplete="off"
            data-client-search
          />
        </div>

        <div class="fg-head">
          <div class="fg-chips" role="group" aria-label="Saldo">
            <button type="button" class="fg-chip" aria-pressed="true" data-debt-filter="all">
              Todos
            </button>
            <button type="button" class="fg-chip" aria-pressed="false" data-debt-filter="debt">
              Con saldo pendiente
            </button>
          </div>
          <p class="fg-muted fg-count" role="status" data-clients-count>
            {clients.length} de {clients.length} clientes
          </p>
        </div>

        <p class="fg-sub fg-notice-text" role="status" tabindex="-1" data-pay-status></p>

        <div class="fg-card fg-table-wrap">
          <table class="fg-table">
            <caption class="sr-only">Cartera de clientes</caption>
            <thead>
              <tr>
                <th scope="col">Cliente</th>
                <th scope="col" class="fg-md">CUIT</th>
                <th scope="col" class="fg-md">Condición</th>
                <th scope="col" class="fg-md">Última compra</th>
                <th scope="col" class="fg-right">Saldo</th>
              </tr>
            </thead>
            <tbody>
              {
                clients.map((c) => (
                  <tr
                    data-client-row
                    data-name={c.name}
                    data-text={clientSearchText(c)}
                    data-balance={c.balance}
                    data-initial={c.balance}
                  >
                    <td>
                      <span class="fg-strong">{c.name}</span>
                      <span class="fg-small fg-muted">
                        {c.phone || "Sin datos de contacto"}
                        <span class="fg-mono fg-sm-only"> · {formatCuit(c.cuit)}</span>
                      </span>
                    </td>
                    <td class="fg-md fg-mono fg-muted">{formatCuit(c.cuit)}</td>
                    <td class="fg-md">
                      <span class="fg-pill">{c.condition}</span>
                    </td>
                    <td class="fg-md fg-muted">{c.lastPurchase}</td>
                    <td class="fg-right">
                      <div class="fg-balance-cell">
                        <span
                          class:list={["fg-badge fg-num", c.balance > 0 ? "fg-badge-warn" : "fg-badge-ok"]}
                          data-balance-label
                        >
                          {c.balance > 0 ? formatArs(c.balance) : "Al día"}
                        </span>
                        {c.balance > 0 && (
                          <button type="button" class="fg-link fg-link-sm" data-pay>
                            Registrar pago
                          </button>
                        )}
                      </div>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="fg-sub" hidden data-clients-empty>No encontramos clientes con esa búsqueda.</p>
      </div>

      <!-- Ventas -->
      <div
        role="tabpanel"
        id="demo-panel-ventas"
        class="fg-panel"
        aria-labelledby="demo-tab-ventas"
        tabindex="0"
        hidden
        data-panel
      >
        <div class="fg-head">
          <div>
            <h3 class="fg-h">Ventas y remitos</h3>
            <p class="fg-sub">Registrá ventas y emití el comprobante fiscal cuando lo necesites.</p>
          </div>
          <button type="button" class="fg-chip" hidden data-sales-reset>Reiniciar ventas</button>
        </div>

        <div class="fg-notice">
          <p class="fg-sub" role="status" data-sales-status>
            Tocá «Facturar» en una venta para emitir una factura de prueba.
          </p>
          <button type="button" class="fg-link" hidden data-goto-fiscal>Ver en Facturación</button>
        </div>

        <div class="fg-card fg-table-wrap">
          <table class="fg-table">
            <caption class="sr-only">Ventas recientes</caption>
            <thead>
              <tr>
                <th scope="col" class="fg-md">Remito</th>
                <th scope="col" class="fg-md">Fecha</th>
                <th scope="col">Cliente</th>
                <th scope="col" class="fg-right">Total</th>
                <th scope="col" class="fg-md">Cobro</th>
                <th scope="col">Fiscal</th>
              </tr>
            </thead>
            <tbody>
              {
                sales.map((s, i) => (
                  <tr data-sale>
                    <td class="fg-md fg-mono fg-up">{s.number}</td>
                    <td class="fg-md fg-muted">{s.date}</td>
                    <td>
                      <span class="fg-strong">{s.client}</span>
                      <span class="fg-small fg-muted fg-mono fg-sm-only">{s.number}</span>
                    </td>
                    <td class="fg-right fg-num fg-bold">{formatArs(s.total)}</td>
                    <td class="fg-md">
                      <span
                        class:list={[
                          "fg-badge",
                          s.payment === "Pagado" && "fg-badge-ok",
                          s.payment === "Pendiente" && "fg-badge-warn",
                        ]}
                      >
                        {s.payment}
                      </span>
                    </td>
                    <td>
                      {s.invoice ? (
                        <span class="fg-badge fg-badge-afip" data-fiscal>
                          {s.invoice.label}
                        </span>
                      ) : (
                        <div class="fg-fiscal-cell">
                          <span class="fg-badge fg-badge-none" data-fiscal data-empty="Sin facturar">
                            Sin facturar
                          </span>
                          <button
                            type="button"
                            class="fg-btn-afip"
                            data-invoice
                            data-index={i}
                            data-client={s.client}
                          >
                            <Receipt size={16} aria-hidden="true" />
                            <span>Facturar</span>
                          </button>
                        </div>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- Facturación -->
      <div
        role="tabpanel"
        id="demo-panel-facturacion"
        class="fg-panel"
        aria-labelledby="demo-tab-facturacion"
        tabindex="0"
        hidden
        data-panel
      >
        <div class="fg-head">
          <div>
            <h3 class="fg-h">Facturación</h3>
            <p class="fg-sub">Comprobantes emitidos. Las facturas nuevas aparecen acá.</p>
          </div>
          <span class="fg-badge fg-badge-afip">Simulación · sin validez fiscal</span>
        </div>

        <div class="fg-card fg-table-wrap">
          <table class="fg-table">
            <caption class="sr-only">Comprobantes emitidos</caption>
            <thead>
              <tr>
                <th scope="col">Comprobante</th>
                <th scope="col" class="fg-md">Cliente</th>
                <th scope="col" class="fg-right">Total</th>
                <th scope="col" class="fg-md">CAE</th>
                <th scope="col">Estado</th>
              </tr>
            </thead>
            <tbody>
              {
                sales.map((s) => (
                  <tr hidden={!s.invoice} data-fiscal-row>
                    <td>
                      <span class="fg-strong" data-fiscal-label>
                        {s.invoice?.label}
                      </span>
                      <span class="fg-small fg-muted fg-sm-only">{s.client}</span>
                    </td>
                    <td class="fg-md">{s.client}</td>
                    <td class="fg-right fg-num fg-bold">{formatArs(s.total)}</td>
                    <td class="fg-md fg-mono fg-muted" data-fiscal-cae>
                      {s.invoice?.cae}
                    </td>
                    <td>
                      <span class="fg-badge fg-badge-ok">Aprobada</span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>

<style>
  /*
   * Tokens de Freggiaro (src/styles/theme.css del sistema), acotados a la demo. El resto de la
   * página sigue con los de engineX. Se omiten los degradados y las sombras de la interfaz real.
   */
  .demo {
    --fg-bg: #0f0f0f;
    --fg-fg: #fafafa;
    --fg-card: #1a1a1a;
    --fg-sidebar: #141414;
    --fg-secondary: #2a2a2a;
    --fg-muted: #a3a3a3;
    --fg-primary: #fbbf24;
    --fg-on-primary: #0f0f0f;
    --fg-primary-subtle: rgb(251 191 36 / 0.1);
    --fg-border: rgb(251 191 36 / 0.15);
    --fg-input: rgb(251 191 36 / 0.2);
    --fg-sidebar-border: rgb(251 191 36 / 0.1);
    --fg-success: #34d399;
    --fg-success-subtle: rgb(16 185 129 / 0.1);
    --fg-warning-subtle: rgb(245 158 11 / 0.12);
    --fg-destructive-subtle: rgb(239 68 68 / 0.12);
    --fg-afip: #4f46e5;
    --fg-afip-text: #a5b4fc;
    --fg-afip-subtle: rgb(79 70 229 / 0.12);
    --fg-radius: 12px;

    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    grid-template-areas:
      "logo header"
      "nav nav"
      "panel panel";
    grid-template-rows: auto auto 1fr;
