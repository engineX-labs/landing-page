---
import { Image } from "astro:assets";
import CircleCheck from "@lucide/astro/icons/circle-check";
import phone from "../assets/hero/reservo-phone.png";
import dashboard from "../assets/projects/freggiaro.png";
import { heroLead, tagline, trustSignals } from "../lib/content";
import { whatsapp } from "../lib/site";
import Button from "./Button.astro";
---

<section id="inicio" class="hero section" aria-labelledby="hero-title">
  <div class="container-x hero-grid">
    <div class="flex max-w-[640px] flex-col gap-6">
      <h1 id="hero-title" class="display hero-title m-0" data-hero style="--i: 0">{tagline}</h1>
      <p class="body-lg m-0 max-w-[56ch] text-ink-muted" data-hero style="--i: 1">{heroLead}</p>
      <div class="mt-2 flex flex-wrap gap-4" data-hero style="--i: 2">
        <Button size="lg" href={whatsapp.chatUrl} target="_blank" rel="noopener" arrow>
          Escribinos por WhatsApp<span class="sr-only"> (se abre en otra pestaña)</span>
        </Button>
        <Button size="lg" variant="secondary" href="#proyectos">Ver proyectos</Button>
      </div>
      <ul class="hero-trust" data-hero style="--i: 3">
        {
          trustSignals.map((signal) => (
            <li>
              <CircleCheck size={18} aria-hidden="true" class="shrink-0 text-success" />
              <span>{signal}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!--
      Mostrar, no prometer: capturas de sistemas que hicimos (el tablero de Freggiaro y el celular
      de Reservo). Son decorativas: el protagonista es engineX, no un producto.
    -->
    <div class="hero-visual" aria-hidden="true">
      <div data-hero style="--i: 4">
        <div class="hero-shot">
          <Image
            src={dashboard}
            alt=""
            widths={[560, 840, 1120]}
            sizes="(min-width: 1024px) 520px, 92vw"
            format="webp"
            loading="eager"
          />
        </div>
      </div>
      <Image
        src={phone}
        alt=""
        class="hero-phone"
        widths={[160, 280]}
        sizes="(min-width: 1024px) 156px, 26vw"
        format="webp"
        loading="eager"
        data-hero
        style="--i: 5"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-16);
  }
  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-24);
    }
  }
  .hero-grid {
    display: grid;
    align-items: center;
    gap: var(--space-12);
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    }
  }

  /* El titular es largo: `display` + balance lo dejan en 3 líneas parejas. */
  .hero-title {
    text-wrap: balance;
  }
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }
  .hero-trust li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* El celular se apoya abajo a la izquierda, por fuera del tablero. */
  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 560px;
    padding: 0 0 var(--space-12) var(--space-12);
    box-sizing: border-box;
    justify-self: center;
  }
  .hero-shot {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .hero-shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-phone {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 22%;
    height: auto;
    pointer-events: none;
  }

  /*
   * El único momento del sitio: cada pieza entra una vez (280 ms, ease-out del sistema), con
   * 60 ms entre una y otra. Es CSS: arranca en el primer cuadro, aunque el JS todavía no llegó,
   * y con `backwards` el estado final es el natural (sin transform residual).
   */
  [data-hero] {
    animation: ex-rise var(--duration-base) var(--ease-out) backwards;
    animation-delay: calc(var(--i, 0) * 60ms);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero] {
      animation-name: ex-fade;
    }
  }
</style>
