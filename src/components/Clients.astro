---
import { clients } from "../lib/content";
---

<section class="border-t border-line py-12" aria-labelledby="clientes-title">
  <div class="container-x flex flex-col items-center gap-8">
    <h2 id="clientes-title" class="label m-0 uppercase text-ink-muted">Confían en nosotros</h2>
    <ul
      class="m-0 flex list-none flex-wrap items-center justify-center gap-x-12 gap-y-8 p-0"
      aria-label="Clientes"
    >
      {
        clients.map((c) => (
          <li class="flex">
            {c.tone === "mono" ? (
              <span
                class="client-logo"
                role="img"
                aria-label={c.name}
                style={`--logo: url(${c.logo}); aspect-ratio: ${c.width} / ${c.height};`}
              />
            ) : (
              <img
                class="client-logo-color"
                src={c.logo}
                alt={c.name}
                width={c.width}
                height={c.height}
                loading="lazy"
              />
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* El PNG es una máscara: el logo se pinta con un color del tema, no con el suyo. */
  .client-logo {
    display: block;
    height: 72px;
    background-color: var(--color-ink-muted);
    mask: var(--logo) center / contain no-repeat;
    -webkit-mask: var(--logo) center / contain no-repeat;
  }
  .client-logo-color {
    display: block;
    height: 72px;
    width: auto;
  }
</style>
