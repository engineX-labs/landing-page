---
import { whatsapp } from "../lib/site";
import { buildStructuredData, serializeJsonLd } from "../lib/structured-data";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Páginas que no tienen que aparecer en buscadores (la demo con datos ficticios). */
  noindex?: boolean;
  /** "papel" es el tema claro de Social Engine (clase `se` en <html>); la home usa "carbon". */
  theme?: "carbon" | "papel";
  siteName?: string;
  /** JSON-LD propio de la página; sin él se usa el de engineX. */
  structuredData?: unknown;
}

const {
  title,
  description,
  noindex = false,
  theme = "carbon",
  siteName = "engineX",
  structuredData,
} = Astro.props;
const light = theme === "papel";
const ogImage = Astro.site
  ? new URL("/brand/enginex-app-icon-512.png", Astro.site).href
  : undefined;
// Sin barra final (salvo la home): es la misma URL que lleva el sitemap.
const canonical = Astro.site
  ? new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), Astro.site).href
  : undefined;
const jsonLd = serializeJsonLd(
  structuredData ??
    buildStructuredData({ site: Astro.site?.origin, whatsappNumber: whatsapp.number }),
);
---

<!doctype html>
<html lang="es-AR" class:list={[light && "se"]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={light ? "#f4f4f2" : "#0e1116"} />
    <meta name="color-scheme" content={light ? "light" : "dark"} />
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && <link rel="sitemap" type="application/xml" href="/sitemap.xml" />}
    <link rel="icon" type="image/svg+xml" href="/brand/enginex-favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/enginex-app-icon-512.png" />
    <link
      rel="preload"
      href="/fonts/PlusJakartaSans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/PlusJakartaSans-800.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={siteName} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    {!noindex && <script type="application/ld+json" is:inline set:html={jsonLd} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
