    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/vercel": "^11.0.16",
    "@lucide/astro": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    },
    "@vercel/routing-utils": {
