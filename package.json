{
  "name": "enginex-landing",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
